{
  "name": "agentfocus-vscode",
  "displayName": "AgentFocus",
  "description": "Focus the exact integrated terminal tab for agentfocus (env-identity: AGENTFOCUS_VSCODE_ID)",
  "version": "1.1.0",
  "publisher": "moonshot",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentfocus.focusTerminal",
        "title": "Focus Terminal (from last request)",
        "category": "AgentFocus"
      },
      {
        "command": "agentfocus.debugListTerminals",
        "title": "Debug: List mapped terminal IDs",
        "category": "AgentFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "typescript": "^5.1.3"
  }
}
