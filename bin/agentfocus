#!/usr/bin/env node
const fs = require('fs');
const path = require('path');
const { execFileSync } = require('child_process');

const args = process.argv.slice(2);
const command = args[0];
const HOME = process.env.HOME;
const REGISTRY_DIR = path.join(HOME, '.local/share/agentfocus/registry');
const LOG_DIR = path.join(HOME, 'Library/Logs/agentfocus');
const LOG_FILE = path.join(LOG_DIR, 'events.jsonl');
const SHARE_DIR = path.join(HOME, '.local/share/agentfocus');
const ADAPTERS_DIR = path.join(SHARE_DIR, 'adapters');
const SETTINGS_PATH = path.join(HOME, '.claude/settings.json');

// Where THIS copy of the CLI lives: the package root (npm tarball, brew keg, or a
// repo checkout), symlinks resolved because npm and brew both install a symlink.
const PKG_ROOT = (() => {
    try { return path.dirname(path.dirname(fs.realpathSync(process.argv[1]))); }
    catch (e) { return path.dirname(__dirname); }
})();
const VERSION = (() => {
    try { return JSON.parse(fs.readFileSync(path.join(PKG_ROOT, 'package.json'), 'utf8')).version; }
    catch (e) { return 'unknown'; }
})();

if (command !== 'uninstall') {
    fs.mkdirSync(REGISTRY_DIR, { recursive: true });
    fs.mkdirSync(LOG_DIR, { recursive: true });
}

function logEvent(event, id, app, ok, detail) {
    const entry = { ts: Date.now(), event, id, app, ok, detail };
    fs.appendFileSync(LOG_FILE, JSON.stringify(entry) + '\n');
}

// macOS major version. The helper calls SMAppService (13+), so an older Mac fails
// at `swiftc` with a compiler error that says nothing about what to do.
function macosMajor() {
    try { return parseInt(execFileSync('sw_vers', ['-productVersion'], { encoding: 'utf8' }).split('.')[0], 10); }
    catch (e) { return NaN; }
}
const MIN_MACOS = 13;

// Strip OUR hook entries from a parsed settings.json, in place. Shared by `init`
// (which re-adds them straight after, so a re-run can never duplicate) and
// `uninstall` (which does not). Matches the {command:"node", args:[...]} shape
// init writes; a hand-written "node /path/emit.js" string is left alone and
// reported by `doctor` instead.
function removeOurHooks(data) {
    const strip = (arr) => {
        for (let i = arr.length - 1; i >= 0; i--) {
            if (!arr[i].hooks) continue;
            arr[i].hooks = arr[i].hooks.filter(h =>
                h.type !== 'command' || h.command !== 'node' ||
                (h.args && h.args[0] && !String(h.args[0]).includes('agentfocus')));
            if (arr[i].hooks.length === 0) arr.splice(i, 1);
        }
    };
    for (const evt of ['Stop', 'Notification', 'UserPromptSubmit']) {
        if (!data.hooks[evt]) data.hooks[evt] = [];
        strip(data.hooks[evt]);
    }
}

// Write settings.json only if the merge actually changed something, preserving the
// file's trailing-newline convention — otherwise a no-op run rewrites a file we
// agree with and leaves a pointless backup. Returns 'unchanged' | 'written'.
function writeSettings(before, data) {
    let after = JSON.stringify(data, null, 2);
    if (before.endsWith('\n') || !fs.existsSync(SETTINGS_PATH)) after += '\n';
    if (after === before) return 'unchanged';
    if (fs.existsSync(SETTINGS_PATH)) fs.copyFileSync(SETTINGS_PATH, `${SETTINGS_PATH}.agentfocus-backup-${Date.now()}`);
    fs.writeFileSync(SETTINGS_PATH, after);
    return 'written';
}

const KNOWN_ADAPTERS = {
    'iterm.app': 'iterm.js',
    'apple_terminal': 'apple_terminal.js',
    'vscode': 'vscode.js',
    'ghostty': 'ghostty.js',
};
const STALE_MS = 6 * 60 * 60 * 1000; // ignore registry entries older than 6h

function getWaitingSessions() {
    if (!fs.existsSync(REGISTRY_DIR)) return [];
    const now = Date.now();
    const files = fs.readdirSync(REGISTRY_DIR).filter(f => f.endsWith('.json'));
    const sessions = [];
    for (const f of files) {
        try {
            const data = JSON.parse(fs.readFileSync(path.join(REGISTRY_DIR, f), 'utf8'));
            if (data.waiting && (now - (data.ts || 0)) < STALE_MS) sessions.push(data);
        } catch(e) {}
    }
    return sessions.sort((a, b) => b.ts - a.ts);
}

// Focus one session. Returns true on success, false if not focusable (unknown
// terminal / no adapter / adapter error) — never runs `tell application "unknown"`.
// exactOnly: refuse the degraded app-level activate, so focus-next can look for a
// session it can actually land on before settling for one.
function focusSession(data, exactOnly) {
    const term = String(data.term_program || '').toLowerCase();
    const appName = data.term_program || 'unknown';
    const adapterName = KNOWN_ADAPTERS[term];
    if (!adapterName) {
        // Editor-panel sessions (e.g. VS Code Claude panel) have no terminal, but
        // editor_app + cwd give window-level routing. `open -a <editor> <folder>`
        // raises the existing window ONLY for a folder that editor already has
        // open; for anything else it SPAWNS one. So ask the editor's own window
        // state (adapters/editor_window.js) and pass a folder only when it
        // confirms one — otherwise activate the app and nothing more. That check
        // replaces both the old `git rev-parse` guess and the 30-minute freshness
        // gate, which only existed to stop stale rows spawning windows.
        // Panel-exact routing needs a vendor API; this is the accepted best-effort.
        const editor = /^[A-Za-z0-9 ._-]+$/.test(String(data.editor_app || '')) ? data.editor_app : null;
        if (editor && data.cwd) {
            let folder = null;
            try {
                folder = require(path.join(ADAPTERS_DIR, 'editor_window.js')).openWindowFor(editor, data.cwd);
            } catch(e) {}  // install predating the verifier → degrade, never guess
            if (!folder && exactOnly) return false;   // let focus-next try elsewhere first
            try {
                // `folder` is the editor's OWN path string, so its already-open
                // check matches it exactly: a pure raise, never a second window.
                if (folder) execFileSync('open', ['-a', editor, folder]);
                else execFileSync('osascript', ['-e', `tell application ${JSON.stringify(editor)} to activate`]);
                data.waiting = false;
                data.ts = Date.now();
                fs.writeFileSync(path.join(REGISTRY_DIR, `${data.session_id}.json`), JSON.stringify(data, null, 2), { mode: 0o600 });
                // `ok` reports whether we landed on the right WINDOW, not whether
                // the click did something — the log must not keep calling a
                // degraded activate a hit. `waiting` clears either way: a session
                // whose folder is closed can never be reached, and leaving it
                // waiting only leaves a banner that no click can clear.
                logEvent('focus', data.session_id, editor, !!folder, folder
                    ? `window-level: ${folder}`
                    : `degraded: activate only (no open window for ${data.cwd})`);
                console.log(folder
                    ? `Focused ${data.session_id} window-level in ${editor} (${folder})`
                    : `Activated ${editor} for ${data.session_id} — no open window for ${data.cwd}`);
                return true;
            } catch(e) {
                logEvent('focus', data.session_id, editor, false, e.message);
            }
        }
        logEvent('focus', data.session_id, appName, false, 'no adapter for term_program');
        console.error(`Skip ${data.session_id}: unfocusable terminal "${appName}"`);
        return false;
    }
    const adapterScript = path.join(ADAPTERS_DIR, adapterName);
    try {
        // execFileSync (not execSync): argv is NOT shell-parsed, so a cwd/title
        // containing a single quote can't break out or inject. Capture stdout so
        // we can tell a real "hit" from a "miss".
        const out = execFileSync(process.execPath, [adapterScript, JSON.stringify(data)], { encoding: 'utf8', maxBuffer: 1 << 20 });
        // Adapters report their outcome as the FIRST token: "hit" (the exact tab or
        // window), "miss" (could not reach it — stay waiting so focus-next retries),
        // or "degraded" (the app is frontmost, the exact surface is unreachable).
        // Reading the first token rather than matching anywhere in the string keeps a
        // folder path that happens to contain one of those words out of the verdict.
        const status = out.trim().split(/\s+/)[0] || '';
        if (status.startsWith('miss')) {
            logEvent('focus', data.session_id, appName, false, out.trim() || 'adapter reported miss');
            console.error(`Miss: ${data.session_id} tab not found in ${appName} (still waiting)`);
            return false;
        }
        data.waiting = false;
        data.ts = Date.now();
        fs.writeFileSync(path.join(REGISTRY_DIR, `${data.session_id}.json`), JSON.stringify(data, null, 2), { mode: 0o600 });
        // A degraded adapter put you in the right APP, not the right tab. Clearing
        // `waiting` is still correct (the banner must not outlive the click), but the
        // log must stop calling that a hit — the lie BUGS #3 was about. Adapters that
        // print nothing at all keep the old benefit of the doubt.
        const exact = !status.startsWith('degraded');
        logEvent('focus', data.session_id, appName, exact, out.trim() || 'ok');
        console.log(exact
            ? `Focused ${data.session_id} in ${appName}`
            : `Activated ${appName} for ${data.session_id} — exact tab not reachable`);
        return true;
    } catch(e) {
        logEvent('focus', data.session_id, appName, false, e.message);
        console.error(`Failed to focus ${data.session_id}: ${e.message}`);
        return false;
    }
}

if (command === 'focus') {
    const id = args[1];
    if (!id || !/^[a-zA-Z0-9_-]+$/.test(id)) {
        console.error("Invalid session id");
        process.exit(1);
    }
    const rp = path.join(REGISTRY_DIR, `${id}.json`);
    if (!fs.existsSync(rp)) {
        console.error(`Session ${id} not found`);
        process.exit(1);
    }
    const data = JSON.parse(fs.readFileSync(rp, 'utf8'));
    process.exit(focusSession(data) ? 0 : 1);
} else if (command === 'focus-next') {
    const waiting = getWaitingSessions();
    let done = false;
    // Pass 1: land exactly if ANY waiting session can. Otherwise the newest editor
    // session whose folder is closed swallows the hotkey and an exactly-focusable
    // terminal session further down the queue never gets a turn.
    for (const s of waiting) {
        if (focusSession(s, true)) { done = true; break; } // try next focusable if one fails
    }
    // Pass 2: settle for a degraded app-level activate — but ONLY for the editor
    // sessions pass 1 refused. Re-running a terminal adapter would activate its app
    // a second time, and re-running a session with no editor at all would just log
    // "unfocusable" twice.
    if (!done) for (const s of waiting) {
        if (KNOWN_ADAPTERS[String(s.term_program || '').toLowerCase()] || !s.editor_app || !s.cwd) continue;
        if (focusSession(s)) { done = true; break; }
    }
    if (!done) console.log(waiting.length ? "No focusable waiting session" : "No waiting sessions");
    process.exit(done ? 0 : 1);
} else if (command === 'list') {
    const waiting = getWaitingSessions();
    if (waiting.length === 0) console.log("No waiting sessions");
    waiting.forEach(s => console.log(`${s.session_id}\t${s.term_program}\t${s.title}\t${s.identity_handle}`));
    process.exit(0);
} else if (command === 'init') {
    // User-space setup. Idempotent: safe to re-run after every brew upgrade.
    // Everything that touches $HOME lives here — the brew formula must not.
    const SHARE = SHARE_DIR;
    const APPS = path.join(HOME, 'Applications');
    const HELPER = path.join(APPS, 'AgentFocus.app');
    const HELPER_EXEC = path.join(HELPER, 'Contents/MacOS/AgentFocus');
    const SETTINGS = SETTINGS_PATH;

    // Source root = the dir containing bin/agentfocus, symlinks resolved
    // (npm and brew both install bin/ as a symlink into the package).
    const root = PKG_ROOT;
    const buildScript = path.join(root, 'helper/build.sh');
    const libexecApp = path.join(root, 'libexec/AgentFocus.app');
    const isDev = fs.existsSync(buildScript);
    if (!isDev && !fs.existsSync(libexecApp)) {
        console.error(`Cannot find the helper source or build at ${root}.`);
        console.error('Run init from a repo checkout, or install with brew first.');
        process.exit(1);
    }

    // Preflight BEFORE anything is copied: every one of these used to fail
    // halfway through, leaving a half-staged runtime and an error that named a
    // compiler rather than the thing to install.
    const major = macosMajor();
    if (major && major < MIN_MACOS) {
        console.error(`macOS ${MIN_MACOS} (Ventura) or newer required — this Mac reports ${major}.`);
        console.error('The menu-bar helper uses SMAppService, which does not exist on older macOS.');
        process.exit(1);
    }
    if (isDev) {
        try { execFileSync('which', ['swiftc'], { stdio: 'ignore' }); }
        catch (e) {
            console.error('Xcode Command Line Tools required (the helper is compiled and');
            console.error('ad-hoc signed on your own machine). Install them with:');
            console.error('  xcode-select --install');
            process.exit(1);
        }
    }

    const running = () => {
        try { execFileSync('pgrep', ['-f', 'AgentFocus.app/Contents/MacOS/AgentFocus'], { stdio: 'ignore' }); return true; }
        catch (e) { return false; }
    };
    const wasRunning = running();  // must be sampled before we launch anything

    // (a) runtime layout. The helper (helper/main.swift) and the hooks both
    // hardcode ~/.local/share/agentfocus, so it stays canonical even under brew.
    for (const d of ['hook', 'adapters', 'bin', 'integrations']) {
        if (!fs.existsSync(path.join(root, d))) continue; // integrations/ is optional
        fs.mkdirSync(path.join(SHARE, d), { recursive: true });
        fs.cpSync(path.join(root, d), path.join(SHARE, d), { recursive: true });
    }
    fs.chmodSync(path.join(SHARE, 'bin/agentfocus'), 0o755);
    for (const h of ['emit.js', 'clear-waiting.js']) fs.chmodSync(path.join(SHARE, 'hook', h), 0o755);
    // The staged CLI needs its own package.json to answer `--version`, and
    // `doctor` compares that against the CLI you invoked to spot a stale runtime.
    try { fs.copyFileSync(path.join(root, 'package.json'), path.join(SHARE, 'package.json')); } catch (e) {}
    console.log(`runtime: ${SHARE} (v${VERSION})`);

    // (b) helper app — ONE location everywhere (~/Applications), because
    // hook/emit.js hardcodes it and SMAppService login items break when a
    // versioned Cellar keg is deleted on upgrade. libexec is just the artifact.
    fs.mkdirSync(APPS, { recursive: true });
    // Compare the executable's bytes, not its mtime: cpSync always bumps mtime,
    // and what matters is whether the RUNNING process is now a stale binary.
    const execBytes = () => { try { return fs.readFileSync(HELPER_EXEC); } catch (e) { return null; } };
    const oldExec = execBytes();
    if (isDev) {
        execFileSync(buildScript, [APPS], { stdio: 'inherit' });
    } else {
        fs.cpSync(libexecApp, HELPER, { recursive: true });
    }
    const replaced = !oldExec || !oldExec.equals(execBytes());
    console.log(`helper:  ${HELPER}${replaced ? ' (updated)' : ''}`);

    fs.writeFileSync(path.join(SHARE, 'config.json'),
        JSON.stringify({ helper: HELPER, version: VERSION }, null, 2) + '\n');

    // (c) Claude hooks. Non-destructive merge, ported from install.sh: strip our
    // own entries then re-append, so a re-run can never duplicate them. Only
    // writes (and only backs up) if the result actually differs — a re-run on a
    // configured machine leaves settings.json byte-identical.
    fs.mkdirSync(path.dirname(SETTINGS), { recursive: true });
    const before = fs.existsSync(SETTINGS) ? fs.readFileSync(SETTINGS, 'utf8') : '{}';
    const data = JSON.parse(before);
    if (!data.hooks) data.hooks = {};
    removeOurHooks(data);  // strip-then-re-append: a re-run can never duplicate
    const hookDef = (f) => ({ hooks: [{ type: 'command', command: 'node', args: [path.join(SHARE, 'hook', f)] }] });
    data.hooks.Stop.push(hookDef('emit.js'));
    data.hooks.Notification.push(hookDef('emit.js'));
    data.hooks.UserPromptSubmit.push(hookDef('clear-waiting.js'));

    if (writeSettings(before, data) === 'unchanged') {
        console.log(`hooks:   already configured, unchanged (${SETTINGS})`);
    } else {
        console.log(`hooks:   installed into ${SETTINGS}${before === '{}' ? '' : ' (backed up)'}`);
    }

    // (d) Launch. `open -g` is idempotent and never steals focus. Restart when we
    // just replaced the bundle under a running (now stale) process. The first
    // requestAuthorization after a fresh install can spuriously fail, so a
    // never-ran-before helper gets the same quit/relaunch treatment.
    // AGENTFOCUS_SKIP_LAUNCH exists so selftest/init-merge.sh can exercise the
    // merge under a throwaway $HOME without launching a bundle out of /tmp
    // (UN rejects those) or registering a stray login item.
    if (!process.env.AGENTFOCUS_SKIP_LAUNCH) {
        execFileSync('open', ['-g', HELPER]);
        if (replaced || !wasRunning) {
            execFileSync('/bin/sleep', ['5']);
            // Match OUR helper by full path: the bare bundle-path fragment also matches
            // an install under a different $HOME, so a test run (or a second account)
            // would stop the real one.
            try { execFileSync('pkill', ['-f', HELPER_EXEC], { stdio: 'ignore' }); } catch (e) {}
            execFileSync('/bin/sleep', ['1']);
            execFileSync('open', ['-g', HELPER]);
            console.log('helper:  relaunched (fresh build / first run)');
        }
    }

    if (!(process.env.PATH || '').split(path.delimiter).some(p => fs.existsSync(path.join(p, 'agentfocus')))) {
        console.log(`\nPATH:    export PATH="${path.join(SHARE, 'bin')}:$PATH"   # add to your shell rc`);
    }

    console.log(`
Permissions — what macOS will ask you, honestly:
  Notifications  macOS is prompting now (or already did). Deny it and banners
                 never appear. System Settings > Notifications > AgentFocus.
  Login item     "AgentFocus Login Item Added" is an FYI banner, not a prompt.
                 Nothing to approve; toggle it from the menu-bar icon.
  Automation     The FIRST banner click for each terminal app prompts once.
                 The grant is keyed to the helper's signature, so upgrading to a
                 NEW VERSION asks once more. Re-running init on the same
                 version does not — released builds are identical bytes.
  Silencers      A macOS Focus mode or Scheduled Summary hides banners with no
                 error anywhere. If banners vanish, check those first.

Next: agentfocus doctor`);
    process.exit(0);
} else if (command === 'uninstall') {
    // Reverses `init`. Everything AgentFocus creates lives in $HOME, so this is
    // the whole removal — no sudo, nothing outside the home directory.
    const purge = args.includes('--purge');
    const HELPER = path.join(HOME, 'Applications/AgentFocus.app');
    const HELPER_EXEC = path.join(HELPER, 'Contents/MacOS/AgentFocus');
    const removed = [];

    // (a) Claude hooks first: if anything below fails, the hooks are already gone
    // and no half-removed install keeps firing at a deleted runtime.
    if (fs.existsSync(SETTINGS_PATH)) {
        try {
            const before = fs.readFileSync(SETTINGS_PATH, 'utf8');
            const data = JSON.parse(before);
            if (!data.hooks) data.hooks = {};
            removeOurHooks(data);
            // Drop the keys we may have created empty, so an uninstall leaves no
            // trace in a settings.json that never had them.
            for (const evt of ['Stop', 'Notification', 'UserPromptSubmit']) {
                if (Array.isArray(data.hooks[evt]) && data.hooks[evt].length === 0) delete data.hooks[evt];
            }
            if (writeSettings(before, data) === 'written') removed.push(`hooks removed from ${SETTINGS_PATH} (backed up)`);
            else console.log(`hooks:   none of ours in ${SETTINGS_PATH}`);
        } catch (e) {
            console.error(`hooks:   could not edit ${SETTINGS_PATH} — ${e.message}`);
            console.error('         remove the three "agentfocus" entries by hand.');
        }
    }

    // (b) Login item, then the process. Unregistering needs the bundle to still
    // exist, so this has to happen before the delete below.
    // A helper built before this flag existed ignores unknown arguments and
    // LAUNCHES — a stray menu-bar app started by an uninstall, hanging until the
    // timeout. The flag's string is present in the binary only if it handles it,
    // so look before leaping. (`timeout` stays as a second line of defence.)
    let flagSupported = false;
    try { flagSupported = fs.readFileSync(HELPER_EXEC).includes('--unregister-login-item'); } catch (e) {}
    if (flagSupported) {
        try {
            execFileSync(HELPER_EXEC, ['--unregister-login-item'], { stdio: 'ignore', timeout: 10000 });
            removed.push('login item unregistered');
        } catch (e) {
            console.log('note:    could not unregister the login item — remove it from');
            console.log('         System Settings > General > Login Items.');
        }
    } else if (fs.existsSync(HELPER_EXEC)) {
        console.log('note:    this helper predates automatic login-item removal — if an');
        console.log('         "AgentFocus" row remains in System Settings > General >');
        console.log('         Login Items, remove it there.');
    }
    // Full path, not the bundle-path fragment: uninstalling under one $HOME must not
    // stop a helper belonging to another account or a test run.
    try { execFileSync('pkill', ['-f', HELPER_EXEC], { stdio: 'ignore' }); removed.push('helper stopped'); } catch (e) {}

    // (c) Files. The registry lives under SHARE_DIR and goes with it.
    for (const p of [HELPER, SHARE_DIR, path.join(HOME, '.cache/agentfocus')].concat(purge ? [LOG_DIR] : [])) {
        if (!fs.existsSync(p)) continue;
        try { fs.rmSync(p, { recursive: true, force: true }); removed.push(p); }
        catch (e) { console.error(`could not remove ${p} — ${e.message}`); }
    }

    if (removed.length === 0) console.log('Nothing to remove — AgentFocus is not installed.');
    else removed.forEach(r => console.log(`removed: ${r}`));

    if (!purge && fs.existsSync(LOG_DIR)) console.log(`\nkept:    ${LOG_DIR}  (use --purge to remove logs too)`);

    // Things we will not touch: a TCC grant is not ours to revoke, and the
    // integration configs were hand-added per integrations/README.md.
    console.log('\nNot removed automatically:');
    console.log('  Automation grant — System Settings > Privacy & Security > Automation > AgentFocus');
    const shims = [
        '.codex/hooks.json',
        '.copilot/hooks/agentfocus.json',
        '.agents/plugins/agentfocus/hooks/hooks.json',
        '.config/opencode/plugins/agentfocus.js',
    ].map(p => path.join(HOME, p)).filter(p => {
        try { return fs.readFileSync(p, 'utf8').includes('agentfocus'); } catch (e) { return false; }
    });
    if (shims.length) {
        console.log('  Integration hooks you added by hand:');
        shims.forEach(p => console.log(`    ${p}`));
    }
    process.exit(0);
} else if (command === 'doctor') {
    // Read-only install health check. Does not touch registry entries or focus.
    const installRoot = path.join(HOME, '.local/share/agentfocus');
    const settingsPath = path.join(HOME, '.claude/settings.json');
    let ok = true;
    const check = (label, pass, detail) => {
        console.log(`${pass ? 'ok' : 'MISSING'}  ${label}${detail ? ' — ' + detail : ''}`);
        if (!pass) ok = false;
    };

    console.log(`AgentFocus Doctor (v${VERSION})`);
    console.log(`Registry: ${REGISTRY_DIR}`);
    console.log(`Logs: ${LOG_DIR}`);
    console.log(`Install: ${installRoot}`);

    // --- host checks: the two things that make an install fail before it starts ---
    const major = macosMajor();
    check(`macOS ${MIN_MACOS}+`, !major || major >= MIN_MACOS,
        major ? `this Mac reports ${major}` : 'could not read sw_vers');
    // Claude Code spawns hooks from a NON-login shell. An nvm-only node is on
    // PATH in your terminal and invisible there, which breaks every hook silently.
    let hookNode = '';
    try { hookNode = execFileSync('/bin/sh', ['-c', 'command -v node'], { encoding: 'utf8' }).trim(); } catch (e) {}
    if (hookNode) console.log(`ok  node visible to hooks — ${hookNode}`);
    else console.log('warn  node NOT visible to a non-login shell — hooks will not run. ' +
        'If you use nvm, install node via brew or symlink it into /usr/local/bin');

    check('CLI binary', fs.existsSync(path.join(installRoot, 'bin/agentfocus')));
    check('emit hook', fs.existsSync(path.join(installRoot, 'hook/emit.js')));
    check('clear-waiting hook', fs.existsSync(path.join(installRoot, 'hook/clear-waiting.js')));

    for (const name of Object.values(KNOWN_ADAPTERS)) {
        check(`adapter ${name}`, fs.existsSync(path.join(ADAPTERS_DIR, name)));
    }

    let hooksOk = false;
    let settings = null;
    try {
        settings = JSON.parse(fs.readFileSync(settingsPath, 'utf8'));
        const blob = JSON.stringify(settings.hooks || {});
        hooksOk = blob.includes('agentfocus') && blob.includes('emit.js');
        const hasClear = blob.includes('clear-waiting.js');
        check('Claude hooks (Stop/Notification emit)', hooksOk, settingsPath);
        check('Claude hooks (UserPromptSubmit clear-waiting)', hasClear, settingsPath);
    } catch (e) {
        check('Claude settings readable', false, e.message);
    }

    // --- helper app + banner-delivery checks (advisory: `warn` never fails the
    // exit code, so `doctor` still means "install is intact"). ---
    const warn = (label, detail) => console.log(`warn  ${label}${detail ? ' — ' + detail : ''}`);
    let helperApp = path.join(HOME, 'Applications/AgentFocus.app');
    try {
        const cfg = JSON.parse(fs.readFileSync(path.join(installRoot, 'config.json'), 'utf8'));
        helperApp = cfg.helper || helperApp;
        // The installed runtime is a COPY. After an upgrade it is whatever the
        // last `init` staged, which is what Claude actually runs — so a mismatch
        // means the hooks are older than this CLI.
        if (cfg.version && VERSION !== 'unknown' && cfg.version !== VERSION) {
            warn(`installed runtime is v${cfg.version}, this CLI is v${VERSION}`, 'run: agentfocus init');
        }
    } catch (e) {}
    check('helper app', fs.existsSync(path.join(helperApp, 'Contents/MacOS/AgentFocus')), helperApp);

    let helperRunning = false;
    try { execFileSync('pgrep', ['-f', 'AgentFocus.app/Contents/MacOS/AgentFocus'], { stdio: 'ignore' }); helperRunning = true; } catch (e) {}
    if (helperRunning) console.log('ok  helper running');
    else warn('helper not running', 'no banners or hotkey until it starts — run: agentfocus init');

    // UN authorization: read what the helper itself logged. Asking macOS costs a
    // TCC surface we refuse to take.
    try {
        const lines = fs.readFileSync(path.join(LOG_DIR, 'helper.log'), 'utf8').trim().split('\n');
        const last = lines.reverse().find(l => l.includes('UN auth granted='));
        if (!last) warn('UN authorization unknown', 'helper has not requested it yet');
        else if (/granted=true/.test(last)) console.log('ok  UN authorization granted');
        else warn('UN authorization NOT granted', 'System Settings > Notifications > AgentFocus > Allow');
    } catch (e) {
        warn('UN authorization unknown', 'no helper log yet');
    }

    // Focus mode / Scheduled Summary silence every banner with no error anywhere.
    // Reading their state needs Full Disk Access (verified: ~/Library/DoNotDisturb
    // is TCC-protected even outside the sandbox), and this tool does not ask for
    // heavy permissions — so this is an advisory, not a probe.
    warn('banner silencers not machine-checkable',
        'if banners never appear, check Control Center > Focus and Notifications > Scheduled Summary');

    let quarantined = false;
    try { execFileSync('xattr', ['-p', 'com.apple.quarantine', helperApp], { stdio: 'ignore' }); quarantined = true; } catch (e) {}
    if (quarantined) warn('helper is quarantined', `fix: xattr -dr com.apple.quarantine ${helperApp}`);

    // Another notifier on Stop = a second banner for the same event.
    try {
        const rivals = ['Stop', 'SubagentStop'].flatMap(evt =>
            (settings?.hooks?.[evt] || []).flatMap(e => e.hooks || [])
                .filter(h => !JSON.stringify(h).includes('agentfocus')).map(h => [evt, h]));
        if (rivals.length) rivals.forEach(([evt, h]) => warn(`rival ${evt} hook (duplicate-banner risk)`, h.command));
        else console.log('ok  no rival Stop/SubagentStop hooks');
    } catch (e) {}

    console.log('note  Automation grants are keyed to the helper\'s signature: upgrading to a new');
    console.log('note  version re-prompts once on the next banner click. Expected. A build from');
    console.log('note  source re-prompts on EVERY rebuild; released builds are identical bytes.');

    const onPath = (process.env.PATH || '').split(path.delimiter).some(p => {
        try { return fs.existsSync(path.join(p, 'agentfocus')); } catch { return false; }
    });
    check('agentfocus on PATH', onPath, onPath ? '' : `add ${path.join(installRoot, 'bin')} to PATH`);

    const waiting = getWaitingSessions();
    console.log(`Waiting sessions: ${waiting.length}`);
    waiting.slice(0, 5).forEach(s => {
        const ageMin = Math.round((Date.now() - (s.ts || 0)) / 60000);
        console.log(`  - ${s.session_id}  ${s.term_program}  ${ageMin}m ago  ${s.title || ''}`);
    });

    // osc_native sessions get no banner from us by design: the terminal posts its
    // own OSC 9/777 notification and owns the click. If the user has that turned
    // off (iTerm ships OSC 9 off), both notifiers are silent and nothing says so.
    [...new Set(waiting.filter(s => s.osc_native).map(s => s.term_program))].forEach(t =>
        warn(`${t} posts its own notifications`,
             'AgentFocus stays silent there by design — if no banner appears, enable that terminal\'s OSC 9/777 notifications'));

    process.exit(ok ? 0 : 1);
} else if (command === 'version' || command === '--version' || command === '-v') {
    console.log(VERSION);
    process.exit(0);
} else {
    console.log("Usage: agentfocus <init | focus | focus-next | list | doctor | uninstall | version> [id]");
    console.log("  uninstall [--purge]   remove everything; --purge also deletes logs");
    process.exit(1);
}
